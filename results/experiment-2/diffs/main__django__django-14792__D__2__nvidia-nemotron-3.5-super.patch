 def _get_timezone_name(timezone):
     """Return the name of ``timezone``."""
+    # For fixed offset timezones, return the tzname (e.g., "+10") instead of
+    # the IANA name (e.g., "Etc/GMT-10") to ensure correct sign handling in
+    # database backends like PostgreSQL.
+    if hasattr(timezone, 'utcoffset'):
+        try:
+            # Check if the offset is fixed (doesn't change with date)
+            offset1 = timezone.utcoffset(datetime(2020, 1, 1))
+            offset2 = timezone.utcoffset(datetime(2020, 7, 1))
+            if offset1 == offset2:
+                tzname = timezone.tzname(None)
+                if tzname:
+                    return tzname
+        except (TypeError, ValueError):
+            pass
     return str(timezone)
 
