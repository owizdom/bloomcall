--- a/django/db/models/sql/datastructures.py
+++ b/django/db/models/sql/datastructures.py
@@ -162,7 +162,12 @@ class Join:
         return hash(self.identity)
 
     def equals(self, other):
-        # Ignore filtered_relation in equality check.
+        # If both joins have filtered_relation, consider it in the equality
+        # check. This allows multiple FilteredRelation with the same relation
+        # but different conditions to create separate joins.
+        if self.filtered_relation is not None and other.filtered_relation is not None:
+            return self.identity == other.identity
+        # Ignore filtered_relation in equality check if at least one is None.
         return self.identity[:-1] == other.identity[:-1]
 
     def demote(self):
