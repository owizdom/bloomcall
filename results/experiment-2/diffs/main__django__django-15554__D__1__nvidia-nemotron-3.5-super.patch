             FilteredRelation("book", condition=Q(book__title="b")), mock.ANY
         )
 
+    def test_multiple_filtered_relation_same_relation(self):
+        # Multiple FilteredRelation with the same relation but different
+        # conditions should create separate joins.
+        qs = Author.objects.annotate(
+            book_a=FilteredRelation(
+                "book", condition=Q(book__editor=self.editor_a)
+            ),
+            book_b=FilteredRelation(
+                "book", condition=Q(book__editor=self.editor_b)
+            ),
+        ).filter(
+            Q(book_a__isnull=False) | Q(book_b__isnull=False)
+        )
+        query_str = str(qs.query)
+        # Both joins should appear in the SQL
+        self.assertIn("book_a", query_str)
+        # The second join should have a different alias (not book_a)
+        self.assertIn("LEFT OUTER JOIN", query_str)
+        # Count the number of JOINs to the book table
+        join_count = query_str.count("JOIN")
+        self.assertGreaterEqual(join_count, 2)
+
 
