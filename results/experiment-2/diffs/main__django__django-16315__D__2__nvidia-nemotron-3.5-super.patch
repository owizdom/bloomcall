diff --git a/tests/bulk_create/tests.py b/tests/bulk_create/tests.py
index 6c490d1..ffe333f 100644
--- a/tests/bulk_create/tests.py
+++ b/tests/bulk_create/tests.py
@@ -34,6 +34,7 @@ from .models import (
     State,
     TwoFields,
     UpsertConflict,
+    UpsertConflictDbColumn,
 )
 
 
@@ -772,3 +773,38 @@ class BulkCreateTests(TestCase):
     @skipIfDBFeature("supports_update_conflicts_with_target")
     def test_update_conflicts_no_unique_fields(self):
         self._test_update_conflicts([])
+
+    @skipUnlessDBFeature(
+        "supports_update_conflicts", "supports_update_conflicts_with_target"
+    )
+    def test_update_conflicts_db_column(self):
+        UpsertConflictDbColumn.objects.bulk_create(
+            [
+                UpsertConflictDbColumn(
+                    blacklistid=1, sectorid=1, name="John"
+                ),
+                UpsertConflictDbColumn(
+                    blacklistid=2, sectorid=2, name="Mary"
+                ),
+            ]
+        )
+        self.assertEqual(UpsertConflictDbColumn.objects.count(), 2)
+
+        conflicting_objects = [
+            UpsertConflictDbColumn(blacklistid=1, sectorid=4, name="Steve"),
+            UpsertConflictDbColumn(blacklistid=2, sectorid=2, name="Olivia"),
+        ]
+        UpsertConflictDbColumn.objects.bulk_create(
+            conflicting_objects,
+            update_conflicts=True,
+            update_fields=["sectorid", "name"],
+            unique_fields=["blacklistid"],
+        )
+        self.assertEqual(UpsertConflictDbColumn.objects.count(), 2)
+        self.assertCountEqual(
+            UpsertConflictDbColumn.objects.values("blacklistid", "sectorid", "name"),
+            [
+                {"blacklistid": 1, "sectorid": 4, "name": "Steve"},
+                {"blacklistid": 2, "sectorid": 2, "name": "Olivia"},
+            ],
+        )
